APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Flutter Project Path (for APK sync)
FLUTTER_PROJECT_PATH=F:/Flutter/city_courierapp

# WhatsApp Provider (Fonnte)
# Daftar di https://fonnte.com untuk mendapatkan token
WHATSAPP_PROVIDER=fonnte
WHATSAPP_ENABLED=true
FONNTE_TOKEN=
FONNTE_SEND_NUMBER=



# OVO SNAP B2B (Consumer Top Up / Disbursement)
# OVO_ENVIRONMENT: mock | sandbox | production. Kredensial resmi diperoleh dari OVO.
OVO_ENVIRONMENT=mock
OVO_MODE=mock
OVO_BASE_URL=
OVO_API_BASE_URL=
OVO_CLIENT_ID=
OVO_CLIENT_SECRET=
OVO_PRIVATE_KEY=
OVO_PUBLIC_KEY=
OVO_PARTNER_ID=
OVO_CHANNEL_ID=
OVO_WEBHOOK_SECRET=

# iPaymu (penarikan saldo kurir ke DANA - payout/disbursement)
# Kredensial hanya dari env/.env; JANGAN menanam API key di aplikasi Flutter.
# IPAYMU_PAYOUT_ENABLED=true HANYA setelah iPaymu mengaktifkan layanan payout
# untuk merchant City Courier. Selama belum aktif, penarikan ditolak server.
IPAYMU_BASE_URL=https://sandbox.ipaymu.com
IPAYMU_MERCHANT_ID=
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_SECRET_KEY=
IPAYMU_PAYOUT_ENABLED=false
IPAYMU_DISBURSE_PATH=/api/v2/disbursement
IPAYMU_INQUIRY_PATH=/api/v2/transaction
IPAYMU_WEBHOOK_SECRET=
IPAYMU_TIMEOUT=30

# Konfigurasi penarikan saldo (fee & batas dari konfigurasi resmi, bukan angka sembarangan)
WITHDRAWAL_MINIMUM=10000
WITHDRAWAL_MAXIMUM=5000000
WITHDRAWAL_ADMIN_FEE=2500
WITHDRAWAL_DAILY_LIMIT=5000000
WITHDRAWAL_RATE_LIMIT_REQUESTS=5
WITHDRAWAL_RATE_LIMIT_WINDOW=10
