APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://www.neonflux.my.id
# Hash commit yang terpasang di server; dibaca oleh GET /api/health.
# Kosongkan bila server punya folder .git (endpoint memakai `git log -1`).
APP_COMMIT=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Flutter Project Path (for APK sync)
FLUTTER_PROJECT_PATH=F:/Flutter/city_courierapp

# WhatsApp Provider (Fonnte)
# Daftar di https://fonnte.com untuk mendapatkan token
WHATSAPP_PROVIDER=fonnte
WHATSAPP_ENABLED=true
FONNTE_TOKEN=
FONNTE_SEND_NUMBER=



# OVO SNAP B2B (Consumer Top Up / Disbursement)
# OVO_ENVIRONMENT: mock | sandbox | production. Kredensial resmi diperoleh dari OVO.
OVO_ENVIRONMENT=mock
OVO_MODE=mock
OVO_BASE_URL=
OVO_API_BASE_URL=
OVO_CLIENT_ID=
OVO_CLIENT_SECRET=
OVO_PRIVATE_KEY=
OVO_PUBLIC_KEY=
OVO_PARTNER_ID=
OVO_CHANNEL_ID=
OVO_WEBHOOK_SECRET=

# iPaymu (penarikan saldo kurir ke DANA - payout/disbursement)
# Kredensial hanya dari env/.env; JANGAN menanam API key di aplikasi Flutter.
# IPAYMU_PAYOUT_ENABLED=true HANYA setelah iPaymu mengaktifkan layanan payout
# untuk merchant City Courier. Selama belum aktif, penarikan ditolak server.
IPAYMU_BASE_URL=https://sandbox.ipaymu.com
IPAYMU_MERCHANT_ID=
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_SECRET_KEY=
IPAYMU_PAYOUT_ENABLED=false
IPAYMU_DISBURSE_PATH=/api/v2/disbursement
IPAYMU_INQUIRY_PATH=/api/v2/transaction
# Inquiry nama pemilik e-wallet tujuan (DANA name inquiry) —
# isi HANYA setelah iPaymu memberikan spec endpoint disbursement.
IPAYMU_INQUIRY_ACCOUNT_PATH=
IPAYMU_WEBHOOK_SECRET=
# Domain email pembeli bila email akun tidak valid (mis. @citycourier.local).
# Kosongkan untuk memakai host dari APP_URL (tanpa prefix www.).
IPAYMU_BUYER_EMAIL_DOMAIN=
# Email NYATA milik merchant, dipakai bila email pembeli tidak layak.
# Isi dengan inbox aktif yang terdaftar di akun iPaymu untuk menghindari
# penolakan "Suspicious buyer" (mis. cs@domain-anda.com).
IPAYMU_BUYER_EMAIL=
IPAYMU_TIMEOUT=30

# Konfigurasi penarikan saldo (fee & batas dari konfigurasi resmi, bukan angka sembarangan)
WITHDRAWAL_MINIMUM=10000
WITHDRAWAL_MAXIMUM=5000000
WITHDRAWAL_ADMIN_FEE=2500
WITHDRAWAL_DAILY_LIMIT=5000000
WITHDRAWAL_RATE_LIMIT_REQUESTS=5
WITHDRAWAL_RATE_LIMIT_WINDOW=10

# City Courier Payment & Wallet System (v1)
# Modes: demo | sandbox | production
PAYMENT_WALLET_MODE=sandbox
PAYMENT_ACTIVE_PROVIDER=xendit
PAYOUT_ACTIVE_PROVIDER=xendit

# Regulatory Gate: MUST remain false in production until BI/OJK & provider approval
CUSTOMER_WITHDRAWAL_REGULATORY_APPROVED=false
CUSTOMER_WITHDRAWAL_SANDBOX_ENABLED=true
CUSTOMER_WITHDRAWAL_MIN_IDR=10000
CUSTOMER_WITHDRAWAL_MAX_IDR=5000000
CUSTOMER_WITHDRAWAL_FEE_IDR=0

# Wallet Top-Up Rules (IDR integer)
WALLET_TOPUP_MIN_IDR=10000
WALLET_TOPUP_MAX_IDR=10000000
WALLET_TOPUP_EXPIRY_MINUTES=60

# Courier Earnings & Auto-Payout Rules
COURIER_COMMISSION_RATE_PERCENT=10
COURIER_SETTLEMENT_WAITING_MINUTES=1440
COURIER_AUTO_RELEASE_ENABLED=true
COURIER_AUTO_PAYOUT_ENABLED=true
COURIER_MIN_PAYOUT_IDR=20000
COURIER_MAX_PAYOUT_IDR=25000000
COURIER_PAYOUT_FEE_IDR=0
COURIER_REQUIRE_AUTO_VERIFIED_DESTINATION=false

# Xendit Sandbox/Production Credentials (Sole Active Payment & Payout Provider - NEVER embed secret keys in Flutter)
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_CALLBACK_TOKEN=
XENDIT_TIMEOUT_SECONDS=30
XENDIT_API_VERSION=2024-11-11
XENDIT_SYNC_PAYOUT_CHANNELS=false
XENDIT_NAME_VALIDATOR_ENABLED=false

# TomTom Traffic API (Flow & Incidents Proxy - keep secret in backend .env only)
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_TIMEOUT_SECONDS=10
TOMTOM_FLOW_CACHE_TTL=60
TOMTOM_INCIDENTS_CACHE_TTL=60
TOMTOM_TILE_CACHE_TTL=60

# Realtime Chat, Laravel Reverb & WhatsApp Business Cloud API (Official Meta)
BROADCAST_CONNECTION=null
REVERB_APP_ID=city-courier-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.neonflux.my.id
REVERB_PORT=443
REVERB_SCHEME=https

CHAT_MEDIA_DISK=local
CHAT_MAX_IMAGE_KB=5120
CHAT_MESSAGES_PER_PAGE=30
CHAT_TYPING_THROTTLE_SECONDS=3

WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=62
WHATSAPP_WINDOW_HOURS=24
WHATSAPP_UTILITY_TEMPLATE_NAME=city_courier_chat_notification
WHATSAPP_UTILITY_TEMPLATE_LANG=id

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
